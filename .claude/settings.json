{
  "hooks": {
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/task-create-to-issue.sh",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/task-complete-to-pr.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
